# Environment Variables for Trilium AI
# Copy this file to .env and update with your values

# OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=sk-...

# Anthropic API Key (if using Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (if using Gemini models)
GEMINI_API_KEY=...

# HuggingFace Token (optional, for faster model downloads and higher rate limits)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Weaviate API Key (if using Weaviate Cloud)
WEAVIATE_API_KEY=

# Path to config file (optional, defaults to config/config.yaml)
TRILIUM_AI_CONFIG=config/config.yaml
