# Environment Variables for Trilium AI
# Copy this file to .env and update with your values

# === LLM Configuration ===
# Override the LLM provider and model (from config.yaml)
# Providers: openai, anthropic, gemini
LLM_PROVIDER=gemini
# Models:
# - OpenAI: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, gpt-5-mini
# - Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# - Gemini: gemini-2.5-flash, gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash-exp
LLM_MODEL=gemini-2.5-flash

# Optional: Override temperature (0.0-1.0, default: 0.7)
# LLM_TEMPERATURE=0.7

# Optional: Override max tokens (default: 2000)
# LLM_MAX_TOKENS=2000

# === API Keys ===
# OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=sk-...

# Anthropic API Key (if using Claude models)
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API Key (if using Gemini models)
# You can also use GOOGLE_API_KEY
GEMINI_API_KEY=...

# HuggingFace Token (optional, for faster model downloads and higher rate limits)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Weaviate API Key (if using Weaviate Cloud)
WEAVIATE_API_KEY=

# Path to config file (optional, defaults to config/config.yaml)
TRILIUM_AI_CONFIG=config/config.yaml
