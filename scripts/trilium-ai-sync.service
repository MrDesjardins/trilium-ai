[Unit]
Description=Trilium AI Incremental Sync
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=%INSTALL_USER%
WorkingDirectory=%INSTALL_PATH%
Environment="PATH=%INSTALL_PATH%/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%UV_PATH% run trilium-ai index --incremental

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trilium-ai-sync

# Security settings
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%INSTALL_PATH%

# Restart policy
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
